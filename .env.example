# Every environment variable the server reads, plus the few that compose.yaml
# uses. `docker compose up` works without a .env file: compose.yaml has a
# development default for each. Copy this file to .env only to override.
# Never commit .env.

# --- Server ------------------------------------------------------------------

# Where the HTTP server listens. Default 0.0.0.0:8080.
BIND_ADDR=0.0.0.0:8080

# The origin users load the app from, without a path. Required.
# Used for the GitHub redirect URL and as the default allowed origin.
PUBLIC_URL=http://localhost:5173

# Comma-separated origins allowed to make state-changing requests and open
# WebSockets. Default: PUBLIC_URL.
ALLOWED_ORIGINS=http://localhost:5173

# Header carrying the client IP, set by a trusted proxy (CF-Connecting-IP
# behind Cloudflare). Leave unset when clients connect directly: anyone can
# send this header, so it is only trustworthy when the proxy is the only way in.
CLIENT_IP_HEADER=

# json (production) or pretty (development). Default json.
LOG_FORMAT=pretty

# Log filter, tracing-subscriber syntax. Default info.
RUST_LOG=info

# Directory with the built web client, served at /. The Docker image sets it
# to /app/web. Unset in development, where Vite serves the client.
STATIC_DIR=

# --- PostgreSQL ----------------------------------------------------------------

# Required. compose.yaml builds it from the POSTGRES_* values below.
DATABASE_URL=postgres://chat:chat@postgres:5432/chat
# Connections per server instance. Default 10.
DATABASE_MAX_CONNECTIONS=10

# Used by compose.yaml for the Postgres container.
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat

# --- Redis ---------------------------------------------------------------------

# Required.
REDIS_URL=redis://redis:6379

# --- ScyllaDB ------------------------------------------------------------------

# Required. Comma-separated host:port contact points.
SCYLLA_NODES=scylla:9042
# Default chat. Lowercase letters, digits and underscores.
SCYLLA_KEYSPACE=chat
# Default 1 (a single node).
SCYLLA_REPLICATION_FACTOR=1

# --- GitHub sign-in (optional) ------------------------------------------------

# From a GitHub OAuth app whose callback URL is
# <PUBLIC_URL>/api/auth/github/callback. Set both, or neither (GitHub sign-in
# is then hidden).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Policy --------------------------------------------------------------------

# Sliding session lifetime, 1 to 365. Default 30.
SESSION_TTL_DAYS=30
# How long guest accounts and their data live, 1 to 168. Default 24.
GUEST_TTL_HOURS=24

# --- Images (compose.yaml only) -----------------------------------------------

# Registry for third-party images. Default docker.io; mirror.gcr.io avoids
# Docker Hub's anonymous pull limit.
IMAGE_REGISTRY=docker.io

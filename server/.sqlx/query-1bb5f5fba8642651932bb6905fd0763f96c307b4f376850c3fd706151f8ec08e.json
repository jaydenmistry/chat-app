{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT r.id, r.name AS \"name!\",\n               count(m.user_id) AS \"member_count!\",\n               bool_or(m.user_id = $1) IS TRUE AS \"joined!\"\n        FROM rooms r LEFT JOIN memberships m ON m.room_id = r.id\n        WHERE r.kind = 'public'\n        GROUP BY r.id\n        ORDER BY count(m.user_id) DESC, r.created_at\n        LIMIT 100\n        ",
